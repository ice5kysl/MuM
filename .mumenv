# MuM 构建环境
#
# 用法： source ./.mumenv && swift build --disable-sandbox
#
# 只做一件事：把 SwiftPM / clang 的模块缓存重定向到 .build/。
#
# 为什么必需：clang 默认把模块缓存写到 $TMPDIR 下的 /var/folders/.../C/clang/ModuleCache，
# 而受限沙箱不让写那里，构建会直接失败：
#     error: unable to open output file '.../ModuleCache/.../SwiftShims-....pcm'
#           'Operation not permitted'
# 实测：只设这两个变量、保持真实 HOME，构建完全正常。

export CLANG_MODULE_CACHE_PATH="$PWD/.build/modulecache"
export SWIFT_MODULE_CACHE_PATH="$PWD/.build/modulecache"

# ⚠️ 曾经这里还有一行 `export HOME="$PWD/.build/home"`。已经删掉，别再加回来：
# 它不是构建需要的（模块缓存的默认位置由 TMPDIR 决定，不是 HOME），
# 却会让所有读 ~/.gitconfig、~/.config/gh、~/Library/Preferences 的命令找不到配置。
# 实际咬过三次：git commit 报 "Author identity unknown"、gh 报 "please run gh auth login"、
# 离屏快照读不到已保存的项目列表。而且症状和真实原因（HOME 被改）看起来毫无关系。

# 可选的 GitHub 代理。
#
# SwiftPM 会隔离 git 的全局配置，导致 ~/.gitconfig 里的代理规则失效、拉取超时。
# 这里用 GIT_CONFIG_COUNT 从环境注入同样的规则，不改用户的 ~/.gitconfig。
#
# 地址不写死在这个文件里 —— 它是机器相关的，不该进版本库。
# 需要的话在 .mumenv.local（已在 .gitignore 里）写一行：
#
#     export GITHUB_PROXY="http://127.0.0.1:10809"
#
if [ -f "$PWD/.mumenv.local" ]; then
    . "$PWD/.mumenv.local"
fi

if [ -n "$GITHUB_PROXY" ]; then
    export GIT_CONFIG_COUNT=1
    export GIT_CONFIG_KEY_0="http.https://github.com.proxy"
    export GIT_CONFIG_VALUE_0="$GITHUB_PROXY"
fi
